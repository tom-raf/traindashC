SUPABASE_DB_PASSWORD=
LDBWS_API_KEY=
LDBWS_API_SECRET=
# No working default — this is the Rail Data Marketplace *gateway* URL for
# your specific subscribed product, not the origin service. Find it on your
# product's subscription/API details page; it looks like
# https://api1.raildata.org.uk/<product-slug>/LDBWS (no trailing /api/... —
# the client appends that itself). realtime.nationalrail.co.uk does NOT work.
LDBWS_BASE_URL=
LDBWS_AUTH_HEADER=x-apikey

# Supabase project settings -> API. Service role key bypasses RLS — never
# expose it to the frontend, backend-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret checked on POST /api/ingest (the pg_cron target). Any long
# random string; must match what's stored in Supabase Vault as 'ingest_secret'
# (see backend/supabase/migrations/0002_ingestion_cron.sql).
INGEST_SECRET=

# Both default to the safe/local option if unset — set explicitly to opt into
# real calls.
DATA_SOURCE=mock
REPOSITORY=memory
